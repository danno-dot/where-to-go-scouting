    // Change map style
    function changeMapStyle(styleName) {
      const style = MAP_STYLES[styleName];
      
      if (typeof style === 'string') {
        // It's a map type (terrain, satellite, hybrid)
        map.setMapTypeId(style);
        map.setOptions({ styles: [] });
      } else {
        // It's a custom style array
        map.setMapTypeId('roadmap');
        map.setOptions({ styles: style });
      }
    }

    function updateStatus(message) {
      document.getElementById('status').textContent = message;
      console.log(message);
    }

    // Toggle filter panel visibility
    function toggleFilterPanel() {
      const panel = document.getElementById('filterPanel');
      const btn = document.getElementById('showFiltersBtn');
      panel.classList.toggle('collapsed');
      btn.style.display = panel.classList.contains('collapsed') ? 'block' : 'none';
    }

    // Select all categories
    function selectAllCategories() {
      Object.keys(categoryVisibility).forEach(category => {
        categoryVisibility[category] = true;
        const checkbox = document.getElementById(`filter-${category.replace(/[^a-zA-Z0-9]/g, '-')}`);
        if (checkbox) checkbox.checked = true;
      });
      updateMarkerVisibility();
    }

    // Deselect all categories
    function deselectAllCategories() {
      Object.keys(categoryVisibility).forEach(category => {
        categoryVisibility[category] = false;
        const checkbox = document.getElementById(`filter-${category.replace(/[^a-zA-Z0-9]/g, '-')}`);
        if (checkbox) checkbox.checked = false;
      });
      updateMarkerVisibility();
    }

    // Toggle category visibility
    function toggleCategory(category) {
      categoryVisibility[category] = !categoryVisibility[category];
      updateMarkerVisibility();
    }

    // Update marker visibility based on selected categories
    function updateMarkerVisibility() {
      markers.forEach(markerObj => {
        const isVisible = categoryVisibility[markerObj.category] !== false;
        markerObj.marker.setVisible(isVisible);
      });
    }

    // Build category filter UI
    function buildCategoryFilters(adventures) {
      // Count adventures per category
      categoryCounts = {};
      adventures.forEach(adventure => {
        const category = (adventure['Category'] || 'Uncategorized').trim();
        categoryCounts[category] = (categoryCounts[category] || 0) + 1;
      });

      // Get unique categories sorted
      const categories = Object.keys(categoryCounts).sort();

      // Initialize only National High Adventure Base as visible by default
      categories.forEach(category => {
        categoryVisibility[category] = (category === 'National High Adventure Base');
      });

      // Build filter UI
      const filterContainer = document.getElementById('categoryFilters');
      filterContainer.innerHTML = '';

      categories.forEach(category => {
        const filterId = `filter-${category.replace(/[^a-zA-Z0-9]/g, '-')}`;
        const count = categoryCounts[category];
        const isChecked = categoryVisibility[category];

        const filterItem = document.createElement('label');
        filterItem.className = 'filter-item';
        filterItem.setAttribute('for', filterId);

        let iconHTML = '';
        if (CATEGORY_ICONS[category]) {
          iconHTML = `<img src="${CATEGORY_ICONS[category]}" alt="${escapeHTML(category)}">`;
        } else {
          const color = CATEGORY_COLORS[category] || CATEGORY_COLORS['default'];
          iconHTML = `<div class="color-circle" style="background-color: ${color};"></div>`;
        }

        filterItem.innerHTML = `
          <input type="checkbox" id="${filterId}" ${isChecked ? 'checked' : ''} onchange="toggleCategory('${escapeHTML(category).replace(/'/g, "\\'")}')">
          ${iconHTML}
          <span>${escapeHTML(category)}</span>
          <span class="count">${count}</span>
        `;

        filterContainer.appendChild(filterItem);
      });

      // Start with filter panel collapsed
      document.getElementById('filterPanel').classList.add('collapsed');
      document.getElementById('showFiltersBtn').style.display = 'block';
    }

    // Initialize the map
    function initMap() {
      updateStatus('Initializing map...');
      
      map = new google.maps.Map(document.getElementById('map'), {
        center: { lat: 39.8283, lng: -98.5795 }, // Center of USA
        zoom: 4,
        styles: MAP_STYLES.retro,
        mapTypeControl: false // Disable the Satellite/Terrain toggle
      });

      infoWindow = new google.maps.InfoWindow();
      geocoder = new google.maps.Geocoder();
      bounds = new google.maps.LatLngBounds();

      updateStatus('Map initialized. Fetching data...');
      
      // Load data from Google Sheet
      mapFetchData();
    }

    // Fetch data from Google Apps Script
    async function mapFetchData() {
      try {
        updateStatus('Fetching from Google Sheet...');
        
        const response = await fetch(MAP_GOOGLE_SCRIPT_URL);
        const data = await response.json();

        console.log('Raw data:', data);

        if (data.error) {
          throw new Error(data.error);
        }

        updateStatus(`Got ${data.rows.length} rows. Filtering...`);

        // Filter to only include featured or approved items
        const adventures = data.rows.filter(row => {
          const status = (row['Published Status'] || '').toLowerCase().trim();
          return status === 'featured' || status === 'approved';
        });

        updateStatus(`${adventures.length} adventures after filtering. Processing locations...`);

        // Store all adventures for filtering
        allAdventures = adventures;

        // Build category filters UI
        buildCategoryFilters(adventures);

        // Log first adventure to see column names
        if (adventures.length > 0) {
          console.log('First adventure:', adventures[0]);
          console.log('Available columns:', Object.keys(adventures[0]));
        }

        // Process each adventure
        await processAdventures(adventures);

        // Hide loading overlay
        document.getElementById('loadingOverlay').style.display = 'none';

      } catch (error) {
        console.error('Error loading data:', error);
        document.getElementById('loadingOverlay').innerHTML = `
          <p style="color: #c53030;">Error loading adventures: ${error.message}</p>
          <p style="margin-top: 10px; font-size: 14px;">Check the browser console for more details.</p>
        `;
      }
    }

    // Process adventures and add markers
    async function processAdventures(adventures) {
      const geocodeCache = {};
      let processed = 0;
      let geocoded = 0;
      let usedExisting = 0;
      
      for (const adventure of adventures) {
        const city = adventure['City'] || '';
        const zipCode = adventure['Zip Code'] || '';
        const state = adventure['State'] || '';
        
        // Check for existing Latitude/Longitude first
        const existingLat = parseFloat(adventure['Latitude']);
        const existingLng = parseFloat(adventure['Longitude']);
        
        processed++;
        
        if (!isNaN(existingLat) && !isNaN(existingLng)) {
          // Use existing coordinates - much faster!
          const location = new google.maps.LatLng(existingLat, existingLng);
          addMarker(adventure, location);
          usedExisting++;
          
          if (processed % 100 === 0) {
            updateStatus(`Processing ${processed}/${adventures.length} (using saved coordinates)...`);
          }
          continue;
        }
        
        // Fall back to geocoding if no coordinates exist
        let locationString = '';
        if (zipCode) {
          locationString = String(zipCode).trim();
        } else if (city && state) {
          locationString = `${city}, ${state}`;
        } else if (city) {
          locationString = city;
        }
        
        if (!locationString) {
          console.log(`Skipping adventure "${adventure['Experience Name']}" - no location data`);
          continue;
        }

        updateStatus(`Geocoding ${processed}/${adventures.length}: ${locationString}`);

        // Check cache first
        if (geocodeCache[locationString]) {
          addMarker(adventure, geocodeCache[locationString]);
          geocoded++;
          continue;
        }

        // Geocode the location
        try {
          const location = await geocodeLocation(locationString);
          if (location) {
            geocodeCache[locationString] = location;
            addMarker(adventure, location);
            geocoded++;
          }
        } catch (error) {
          console.log(`Could not geocode: ${locationString}`, error);
        }

        // Small delay to avoid hitting API rate limits
        await new Promise(resolve => setTimeout(resolve, 150));
      }

      if (usedExisting > 0) {
        updateStatus(`Done! ${usedExisting} from saved coords, ${geocoded} geocoded.`);
      } else {
        updateStatus(`Done! Placed ${geocoded} markers.`);
      }

      // Fit map to show all markers
      if (markers.length > 0) {
        map.fitBounds(bounds);
      }
    }

    // Geocode a location string
    function geocodeLocation(address) {
      return new Promise((resolve, reject) => {
        geocoder.geocode({ address: address }, (results, status) => {
          if (status === 'OK' && results[0]) {
            resolve(results[0].geometry.location);
          } else {
            reject(status);
          }
        });
      });
    }

    // Add a marker to the map
    function addMarker(adventure, location) {
      const category = (adventure['Category'] || 'default').trim();
      
      let markerOptions = {
        position: location,
        map: map,
        title: adventure['Experience Name'] || 'Adventure'
      };

      // Check if we have a custom icon for this category
      if (CATEGORY_ICONS[category]) {
        markerOptions.icon = {
          url: CATEGORY_ICONS[category],
          scaledSize: new google.maps.Size(40, 40),
          anchor: new google.maps.Point(20, 20)
        };
      } else {
        // Use colored circle as fallback
        const color = CATEGORY_COLORS[category] || CATEGORY_COLORS['default'];
        markerOptions.icon = {
          path: google.maps.SymbolPath.CIRCLE,
          fillColor: color,
          fillOpacity: 1,
          strokeColor: '#ffffff',
          strokeWeight: 2,
          scale: 10
        };
      }

      const marker = new google.maps.Marker(markerOptions);

      // Set initial visibility based on category filter
      marker.setVisible(categoryVisibility[category] !== false);

      // Extend bounds to include this marker (only if visible)
      if (categoryVisibility[category] !== false) {
        bounds.extend(location);
      }

      // Add click listener for info window
      marker.addListener('click', () => {
        const content = createInfoWindowContent(adventure);
        infoWindow.setContent(content);
        infoWindow.open(map, marker);
      });

      // Store marker with category for filtering
      markers.push({
        marker: marker,
        category: category,
        adventure: adventure
      });
    }

    // Create info window content
    function createInfoWindowContent(adventure) {
      const name = adventure['Experience Name'] || 'Adventure';
      const category = adventure['Category'] || '';
      const description = adventure['Description'] || '';
      const city = adventure['City'] || '';
      const state = adventure['State'] || '';
      const region = adventure['Region'] || '';
      const activityUrl = adventure['Activity URL'] || '';
      const cost = adventure['Cost'] || '';
      const season = adventure['Season'] || '';

      let locationText = '';
      if (city && state) {
        locationText = `${city}, ${state}`;
      } else if (city) {
        locationText = city;
      } else if (region) {
        locationText = region;
      }

      let html = `<div class="info-window">`;
      html += `<h3>${escapeHTML(name)}</h3>`;
      
      if (category) {
        html += `<span class="category-badge">${escapeHTML(category)}</span>`;
      }
      
      if (locationText) {
        html += `<p><strong>Location:</strong> ${escapeHTML(locationText)}</p>`;
      }
      
      if (season) {
        html += `<p><strong>Season:</strong> ${escapeHTML(season)}</p>`;
      }
      
      if (cost) {
        html += `<p><strong>Cost:</strong> ${escapeHTML(cost)}</p>`;
      }
      
      if (description) {
        const shortDesc = description.length > 150 ? description.substring(0, 150) + '...' : description;
        html += `<p>${escapeHTML(shortDesc)}</p>`;
      }
      
      if (activityUrl) {
        html += `<a href="${escapeHTML(activityUrl)}" target="_blank">View Details →</a>`;
      }
      
      html += `</div>`;
      
      return html;
    }

    // Escape HTML
    function escapeHTML(str) {
      if (!str) return '';
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    // Handle Google Maps loading error
    function gm_authFailure() {
      document.getElementById('loadingOverlay').innerHTML = `
        <p style="color: #c53030;">Google Maps API authentication failed.</p>
        <p style="margin-top: 10px; font-size: 14px;">Please check that your API key is valid and has the Maps JavaScript API and Geocoding API enabled.</p>
      `;
    }
  </script>

  <script async defer src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAqDWWd6YJ2Qq0C2fUvY5C4-xl8WubNiYc&callback=initMap"></script>

